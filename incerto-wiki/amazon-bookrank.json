fier":"intuition","label":"Intuition","html_id":"intuition","implicit":true,"key":"iBZq7TSoqb"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Book sales are a natural “winner-take-more” setting.  Most titles sell little\nin a given week, while a few sell much more.  A rank is not the same object as\na sales count, but if sales approximately follow a power law, a log-log plot of\nsales against rank can look close to linear over part of the range.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"gm6KIycm3G"}],"key":"BvNpSpvCjx"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"The important word is “approximately.”  Amazon’s ranking algorithm is not a\nstatistical law of nature, and this old dataset is small.  The example is a\nreal-data bridge from the Pareto pages to rank-size empirical work.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"C1OhGdpDRS"}],"key":"xxVi3W0gsj"},{"type":"heading","depth":2,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Proof","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"WRRC3jjk8R"}],"identifier":"proof","label":"Proof","html_id":"proof","implicit":true,"key":"KKPVUR6YH8"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"There is no proof that the data are Pareto.  The computation is a reproducible\ndiagnostic:","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"Cv4a6cO2q9"}],"key":"SgvzuIBVp9"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":40,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Load the CC0 snapshot.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"EtHmZfpO7K"}],"key":"p75stOq3Q0"}],"key":"JJ547WzmGT"},{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plot weekly sales against weekly average rank on log-log axes.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"dxKJjU7toX"}],"key":"HfSoZsrUHB"}],"key":"KjMjOIxK3Y"},{"type":"listItem","spread":true,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fit a log-log line as a descriptive rank-size summary.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"tVe1MjaQJk"}],"key":"SX4eu6n8dK"}],"key":"KtvRJVhHm4"},{"type":"listItem","spread":true,"position":{"start":{"line":43,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Apply ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"gvT0Qw7dLG"},{"type":"link","url":"/hill-estimator","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Hill Estimator","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"uOSJmSYkq1"}],"urlSource":"../methods/hill-estimator.md","dataUrl":"/hill-estimator.json","internal":true,"protocol":"file","key":"sbHfwRTd1d"},{"type":"text","value":" sensitivity checks to\npositive weekly sales above a small reporting cutoff.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"GfgESTIRQ5"}],"key":"DlVHKFofEJ"}],"key":"Y8F27L0zbH"}],"key":"IigbGFCqkg"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Any resulting exponent is sample-specific and should be read as an empirical\ndescription, not a structural parameter of Amazon.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"QUQ19t3HXb"}],"key":"qMdfej9khB"},{"type":"heading","depth":2,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Python","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"RimkCwrInn"}],"identifier":"python","label":"Python","html_id":"python","implicit":true,"key":"x9C8xqEmhU"}],"key":"GE9U21uw7y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import linregress\n\nfrom incerto.datasets import load_amazon_bookrank\nfrom incerto.estimators import hill_alpha_estimator, hill_stability\nfrom incerto.figures import COLORS, FIGURE_SIZES, set_theme, style_axes\n\nset_theme()\n\ndata = load_amazon_bookrank()\nsales = data.weekly_sales\nranks = data.weekly_average_rank\n\nmask = (sales > 0) & (ranks > 0)\nlog_rank = np.log(ranks[mask])\nlog_sales = np.log(sales[mask])\nslope, intercept, r_value, _, _ = linregress(log_rank, log_sales)\n\ntail_sample = sales[sales > 10]\nks = np.unique(np.geomspace(5, min(140, tail_sample.size - 1), 60).astype(int))\nstability = hill_stability(tail_sample, ks)\n\nfig, axes = plt.subplots(1, 2, figsize=FIGURE_SIZES[\"two_panel\"])\n\naxes[0].scatter(ranks, sales, s=14, alpha=0.65, color=COLORS[\"accent\"])\nrank_grid = np.geomspace(ranks.min(), ranks.max(), 150)\naxes[0].plot(\n    rank_grid,\n    np.exp(intercept) * rank_grid**slope,\n    color=COLORS[\"umber\"],\n    ls=\"--\",\n    label=f\"log-log slope {slope:.2f}\",\n)\naxes[0].set_xscale(\"log\")\naxes[0].set_yscale(\"log\")\naxes[0].set_xlabel(\"weekly average rank\")\naxes[0].set_ylabel(\"weekly sales\")\naxes[0].set_title(\"Sales rank relation\")\naxes[0].legend()\n\naxes[1].semilogx(stability[\"k\"], stability[\"alpha\"], color=COLORS[\"green\"])\naxes[1].set_xlabel(\"upper order statistics k\")\naxes[1].set_ylabel(\"Hill alpha\")\naxes[1].set_title(\"Weekly-sales tail\")\n\nstyle_axes(axes, grid_axis=\"both\")\nfig.tight_layout()\nplt.show()\n\nprint(f\"Rows: {sales.size}; titles dated from {data.date.min()} to {data.date.max()}\")\nprint(f\"Log-log rank/sales R^2: {r_value**2:.3f}\")\nfor k in [10, 20, 40, 80, 120]:\n    if k < tail_sample.size:\n        print(f\"Hill alpha on sales > 10 for k={k:3d}: {hill_alpha_estimator(tail_sample, k):.2f}\")","identifier":"amazon-bookrank-python-check-code","enumerator":"1","html_id":"amazon-bookrank-python-check-code","key":"PCV2b3mUYo"},{"type":"outputs","id":"junqgyfiT6QWagGRotYsn","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1152x547.2 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"f0990865fd09b9dcb9efddf831aece1b","path":"/incerto-wiki/build/f0990865fd09b9dcb9efddf831aece1b.png"}}},"identifier":"amazon-bookrank-python-check-outputs-0","html_id":"amazon-bookrank-python-check-outputs-0","key":"mAE9126WOd"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Rows: 861; titles dated from 2001-04-21 to 2001-05-05\nLog-log rank/sales R^2: 0.801\nHill alpha on sales > 10 for k= 10: 3.67\nHill alpha on sales > 10 for k= 20: 2.51\nHill alpha on sales > 10 for k= 40: 2.27\nHill alpha on sales > 10 for k= 80: 2.12\nHill alpha on sales > 10 for k=120: 2.07\n"},"identifier":"amazon-bookrank-python-check-outputs-1","html_id":"amazon-bookrank-python-check-outputs-1","key":"JCOqBcjIWS"}],"identifier":"amazon-bookrank-python-check-outputs","html_id":"amazon-bookrank-python-check-outputs","key":"BlUdvQ4jE5"}],"label":"amazon-bookrank-python-check","identifier":"amazon-b