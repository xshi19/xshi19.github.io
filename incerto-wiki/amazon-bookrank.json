"column":1},"end":{"line":41,"column":1}},"key":"yZiQSmakBP"}],"urlSource":"../distributions/pareto.md","dataUrl":"/pareto.json","internal":true,"protocol":"file","key":"KCtTEXrvnO"},{"type":"text","value":" pages to\nrank-size empirical work.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"L9M9f2yhA9"}],"key":"xDAXKamQb6"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Evidence and model comparison","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"n8LVcib0Ag"}],"identifier":"evidence-and-model-comparison","label":"Evidence and model comparison","html_id":"evidence-and-model-comparison","implicit":true,"key":"UmshGNrreA"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"There is no proof that the data are Pareto.  The computation is a reproducible\ndiagnostic:","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"CBrDEGAYvD"}],"key":"qsyKtD8fW4"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":51,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Load the CC0 snapshot.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"RpncPFojxJ"}],"key":"nRRGTTvHYa"}],"key":"tdoYx5nEk6"},{"type":"listItem","spread":true,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plot weekly sales against weekly average rank on log-log axes.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"kNoshqiqr3"}],"key":"fO1gCgPpsk"}],"key":"e36b4FYw95"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plot empirical sales survival on log-log axes.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"DddZhPGiPX"}],"key":"r1dMIJg9we"}],"key":"SfaRBaQzYh"},{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Apply ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"aA9BLKm4Qw"},{"type":"link","url":"/hill-estimator","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Hill Estimator","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"agnE3dR4qm"}],"urlSource":"../methods/hill-estimator.md","dataUrl":"/hill-estimator.json","internal":true,"protocol":"file","key":"oefASi4bYq"},{"type":"text","value":" sensitivity checks to\npositive weekly sales above a small reporting cutoff.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"bAb4hmgSG9"}],"key":"l0R3v6syql"}],"key":"dp8KUbQsmn"}],"key":"HAJRpgCzoc"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Any resulting exponent is sample-specific and should be read as an empirical\ndescription, not a structural parameter of Amazon.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"vyTjMLCEOy"}],"key":"i3uQURJmey"}],"key":"BDKqUQeYZE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import linregress\n\nfrom incerto.datasets import load_amazon_bookrank\nfrom incerto.estimators import hill_alpha_estimator, hill_stability\nfrom incerto.figures import COLORS, FIGURE_SIZES, set_theme, style_axes\n\nset_theme()\n\ndata = load_amazon_bookrank()\nsales = data.weekly_sales\nranks = data.weekly_average_rank\n\nmask = (sales > 0) & (ranks > 0)\nlog_rank = np.log(ranks[mask])\nlog_sales = np.log(sales[mask])\nslope, intercept, r_value, _, _ = linregress(log_rank, log_sales)\n\npositive_sales = np.sort(sales[sales > 0])\nsales_survival = 1 - np.arange(1, positive_sales.size + 1) / (positive_sales.size + 1)\n\ntail_sample = sales[sales > 10]\nk_max = max(6, min(140, tail_sample.size - 1))\nks = np.unique(np.geomspace(5, k_max, 60).astype(int))\nstability = hill_stability(tail_sample, ks)\n\nfig, axes = plt.subplots(1, 3, figsize=FIGURE_SIZES[\"three_panel\"])\n\naxes[0].scatter(ranks, sales, s=14, alpha=0.65, color=COLORS[\"accent\"])\nrank_grid = np.geomspace(ranks.min(), ranks.max(), 150)\naxes[0].plot(\n    rank_grid,\n    np.exp(intercept) * rank_grid**slope,\n    color=COLORS[\"umber\"],\n    ls=\"--\",\n    label=f\"log-log slope {slope:.2f}\",\n)\naxes[0].set_xscale(\"log\")\naxes[0].set_yscale(\"log\")\naxes[0].set_xlabel(\"weekly average rank\")\naxes[0].set_ylabel(\"weekly sales\")\naxes[0].set_title(\"Sales-rank relation\")\naxes[0].legend()\n\naxes[1].loglog(positive_sales, sales_survival, color=COLORS[\"teal\"])\naxes[1].set_xlabel(\"weekly sales\")\naxes[1].set_ylabel(\"empirical survival\")\naxes[1].set_title(\"Sales survival\")\n\naxes[2].semilogx(stability[\"k\"], stability[\"alpha\"], color=COLORS[\"green\"])\naxes[2].set_xlabel(\"upper order statistics k\")\naxes[2].set_ylabel(r\"Hill $\\widehat\\alpha$\")\naxes[2].set_title(\"Tail sensitivity\")\n\nstyle_axes(axes, grid_axis=\"both\")\nplt.show()\n\nprint(f\"Rows: {sales.size}; titles dated from {data.date.min()} to {data.date.max()}\")\nprint(f\"Log-log rank/sales R^2: {r_value**2:.3f}\")\nfor k in [10, 20, 40, 80, 120]:\n    if k < tail_sample.size:\n        print(f\"Hill alpha on sales > 10 for k={k:3d}: {hill_alpha_estimator(tail_sample, k):.2f}\")","identifier":"amazon-bookrank-tail-diagnostics-code","visibility":"hide","enumerator":"1","html_id":"amazon-bookrank-tail-diagnostics-code","key":"AEE1cXL3Eo"},{"type":"outputs","id":"1BpIL1xnvHO-UjjgGAIUU","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1512x518.4 with 3 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"a20a176d11e300bf15965a5a65c3a80b","path":"/incerto-wiki/build/a20a176d11e300bf15965a5a65c3a80b.png"}}},"identifier":"amazon-bookrank-tail-diagnostics-outputs-0","html_id":"amazon-bookrank-tail-diagnostics-outputs-0","key":"XklkTAb2TQ"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Rows: 861; titles dated from 2001-04-21 to 2001-05-05\nLog-log rank/sales R^2: 0.801\nHill alpha on sales > 10 for k= 10: 3.67\nHill alpha on sales > 10 for k= 20: 2.51\nHill alpha on sales > 10 for k= 40: 2.27\nHill alpha on sales > 10 for k= 80: 2.12\nHill alpha on sales > 10 for k=120: 2.07\n"},"identifier":"amazon-bookrank-tail-diagnostics-outputs-1","html_id":"amazon-bookrank-tail-diagnostics-outputs-1","key":"dxD6mNI4bT"}],"identifier":"amazon-bookrank-tail-diagnostics-outputs","visibility":"show","html_id":"amazon-bookrank-tail-diagnostics-outputs","key":"YDBp2ruqDJ"}],"data":{"tags":[]},"label":"amazon-bookrank-tail-diagnostics","identifier":"amazon-bookrank-tail-diagnostics","visibility":"show","html_id":"amazon-bookrank-tail-diagnostics","key":"vco5NBvDx0"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":129,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"strong","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"What to notice.","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"Ga3uHnDNkJ"}],"key":"HL0TuYlpMD"},{"type":"text","value":" The log-log fit captures a