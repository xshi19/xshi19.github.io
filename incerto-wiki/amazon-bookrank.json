n":[{"type":"text","value":"Any resulting exponent is sample-specific and should be read as an empirical\ndescription, not a structural parameter of Amazon.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"MLtPHqdTF5"}],"key":"NmGtP2aBQA"},{"type":"heading","depth":2,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Python","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"x8PQ3zVqGv"}],"identifier":"python","label":"Python","html_id":"python","implicit":true,"key":"GxQD3lLpgp"}],"key":"jmBb20EX58"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import linregress\n\nfrom incerto.datasets import load_amazon_bookrank\nfrom incerto.estimators import hill_alpha_estimator, hill_stability\nfrom incerto.figures import COLORS, FIGURE_SIZES, set_theme, style_axes\n\nset_theme()\n\ndata = load_amazon_bookrank()\nsales = data.weekly_sales\nranks = data.weekly_average_rank\n\nmask = (sales > 0) & (ranks > 0)\nlog_rank = np.log(ranks[mask])\nlog_sales = np.log(sales[mask])\nslope, intercept, r_value, _, _ = linregress(log_rank, log_sales)\n\ntail_sample = sales[sales > 10]\nks = np.unique(np.geomspace(5, min(140, tail_sample.size - 1), 60).astype(int))\nstability = hill_stability(tail_sample, ks)\n\nfig, axes = plt.subplots(1, 2, figsize=FIGURE_SIZES[\"two_panel\"])\n\naxes[0].scatter(ranks, sales, s=14, alpha=0.65, color=COLORS[\"accent\"])\nrank_grid = np.geomspace(ranks.min(), ranks.max(), 150)\naxes[0].plot(\n    rank_grid,\n    np.exp(intercept) * rank_grid**slope,\n    color=COLORS[\"umber\"],\n    ls=\"--\",\n    label=f\"log-log slope {slope:.2f}\",\n)\naxes[0].set_xscale(\"log\")\naxes[0].set_yscale(\"log\")\naxes[0].set_xlabel(\"weekly average rank\")\naxes[0].set_ylabel(\"weekly sales\")\naxes[0].set_title(\"Sales rank relation\")\naxes[0].legend()\n\naxes[1].semilogx(stability[\"k\"], stability[\"alpha\"], color=COLORS[\"green\"])\naxes[1].set_xlabel(\"upper order statistics k\")\naxes[1].set_ylabel(\"Hill alpha\")\naxes[1].set_title(\"Weekly-sales tail\")\n\nstyle_axes(axes, grid_axis=\"both\")\nfig.tight_layout()\nplt.show()\n\nprint(f\"Rows: {sales.size}; titles dated from {data.date.min()} to {data.date.max()}\")\nprint(f\"Log-log rank/sales R^2: {r_value**2:.3f}\")\nfor k in [10, 20, 40, 80, 120]:\n    if k < tail_sample.size:\n        print(f\"Hill alpha on sales > 10 for k={k:3d}: {hill_alpha_estimator(tail_sample, k):.2f}\")","identifier":"amazon-bookrank-python-check-code","enumerator":"1","html_id":"amazon-bookrank-python-check-code","key":"qrJctz7CjQ"},{"type":"outputs","id":"p8ZnU0cW5b_8pBvhMRA3T","children":[],"identifier":"amazon-bookrank-python-check-outputs","html_id":"amazon-bookrank-python-check-outputs","key":"yu0EJXRvGf"}],"label":"amazon-bookrank-python-check","identifier":"amazon-bookrank-python-check","html_id":"amazon-bookrank-python-check","key":"Jk8lYQC411"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"The log-log fit usually captures the broad rank-size direction, while the Hill\ncurve shows that the tail exponent is threshold-sensitive even in this small,\nclean dataset.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"AWxQvtjXdw"}],"key":"jofkwHqEEh"},{"type":"heading","depth":2,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"Caveats","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"oPTTCluW0w"}],"identifier":"caveats","label":"Caveats","html_id":"caveats","implicit":true,"key":"M83IBjIkHW"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":117,"column":1},"end":{"line":127,"column":1}},"