:{"line":72,"column":1}},"key":"mUAfMKg5Lw"}],"key":"IVUXEBqRh6"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"These identities are normal-model calibrations, not tail theorems.  If the\nsample has extreme observations, the standard deviation’s quadratic loss gives\nthose observations much more weight than either absolute-deviation statistic.\nIf the variance is infinite, as with a Cauchy distribution, the sample standard\ndeviation is not estimating a finite population quantity.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"FrLL1s7nXo"}],"key":"WgKd2kpetZ"},{"type":"heading","depth":2,"position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Python","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"X0NLvnzAiH"}],"identifier":"python","label":"Python","html_id":"python","implicit":true,"key":"t3Sf3KjNfa"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"The simulation reproduces the Chapter 4 contrast with deterministic samples.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"cE7WBA4Oif"}],"key":"m6aD6Y3zhf"}],"key":"eatKkjyjFf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nfrom scipy.stats import cauchy, t\n\nfrom incerto.distributions import univariate_variance_gamma\nfrom incerto.stats import mean_absolute_deviation, median_absolute_deviation\n\n\ndef dispersion_ratios(sample):\n    std = np.std(sample)\n    mean_ad = mean_absolute_deviation(sample)\n    median_ad = median_absolute_deviation(sample)\n    median_ratio = np.inf if median_ad == 0 else std / median_ad\n    return std / mean_ad, median_ratio\n\n\nrng = np.random.default_rng(20260523)\nn = 200_000\nsamples = {\n    \"normal\": rng.normal(size=n),\n    \"variance-gamma\": univariate_variance_gamma.rvs(\n        1.0, 0.0, 0.5, size=n, random_state=rng\n    ),\n    \"student-t(3)\": t.rvs(df=3, size=n, random_state=rng),\n    \"cauchy\": cauchy.rvs(size=n, random_state=rng),\n}\n\nextreme = np.ones(n)\nextreme[0] = 1_000_000.0\nsamples[\"single-outlier\"] = extreme\n\nprint(\"sample           Std/MeanAD  Std/MedianAD\")\nfor name, sample in samples.items():\n    mean_ratio, median_ratio = dispersion_ratios(sample)\n    print(f\"{name:15s} {mean_ratio:8.2f} {median_ratio:8.2f}\")","identifier":"dispersion-ratio-python-check-code","enumerator":"1","html_id":"dispersion-ratio-python-check-code","key":"Vs4plIA7pO"},{"type":"outputs","id":"88TqwsjN8bpSGjfe_vYEU","children":[],"identifier":"dispersion-ratio-python-check-outputs","html_id":"dispersion-ratio-python-check-outputs","key":"iASaLtMfkZ"}],"label":"dispersion-ratio-python-check","identifier":"dispersion-ratio-python-check","html_id":"dispersion-ratio-python-check","key":"GNWyyIJiH2"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":124,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"The normal ratios should be close to ","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"OcDLZl5nap"},{"type":"inlineCode","value":"1","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"CiERhYuvVs"},{"type":"text","value":".  The heavy-tailed and contaminated\nsamples produce larger ratios; the single-outlier example makes the median\nabsolute deviation equal to zero, so the second ratio is infinite.","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"tO2r6TWx8e"}],"key":"Xfic8PvsGU"},{"type":"heading","depth":2,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Caveats","position":{"start":{"line":128,"column":1},"end":{"line":128,"colu