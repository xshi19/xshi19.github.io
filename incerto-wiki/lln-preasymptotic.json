e_axes\n\nset_theme()\n\nn = 1_000_000\ncheckpoints = np.unique(np.geomspace(10, n, 90).astype(int))\n\nfig, ax = plt.subplots(figsize=FIGURE_SIZES[\"single\"])\n\nfor alpha, seed, color in [\n    (0.8, 20260523, COLORS[\"brick\"]),\n    (1.3, 20260525, COLORS[\"green\"]),\n]:\n    rng = np.random.default_rng(seed)\n    sample = pareto_type1.rvs(alpha, size=n, random_state=rng)\n    means = running_mean(sample)\n\n    ax.loglog(\n        checkpoints,\n        means[checkpoints - 1],\n        color=color,\n        label=f\"alpha={alpha}\",\n    )\n\n    final_mean = float(means[-1])\n    max_share = float(max_to_sum_ratio(sample))\n    print(f\"Pareto alpha={alpha}:\")\n    print(f\"  final running mean after {n:,} draws: {final_mean:.3f}\")\n    print(f\"  largest observation's share of total: {max_share:.3f}\")\n\n    if alpha > 1:\n        print(f\"  finite theoretical mean: {alpha / (alpha - 1):.3f}\")\n        ax.axhline(\n            alpha / (alpha - 1),\n            color=color,\n            ls=\"--\",\n            alpha=0.8,\n        )\n    else:\n        print(\"  finite theoretical mean: none\")\n\nax.set_xlabel(\"sample size n\")\nax.set_ylabel(\"running mean\")\nax.set_title(\"Pre-asymptotic running means\")\nax.legend()\nstyle_axes(ax, grid_axis=\"both\")\nplt.show()","identifier":"lln-preasymptotic-python-check-code","enumerator":"1","html_id":"lln-preasymptotic-python-check-code","key":"IjLsyo1hfW"},{"type":"outputs","id":"FYXXa_LWYBBaaoF28HhIv","children":[],"identifier":"lln-preasymptotic-python-check-outputs","html_id":"lln-preasymptotic-python-check-outputs","key":"lmBWATZOog"}],"label":"lln-preasymptotic-python-check","identifier":"lln-preasymptotic-python-check","html_id":"lln-preasymptotic-python-check","key":"h7g4JJwhCz"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":117,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"For ","position":{"start":{"line":117,"column":1},"end":{"line":117