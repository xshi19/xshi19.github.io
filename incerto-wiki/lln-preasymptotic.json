t_theme, style_axes\n\nset_theme()\n\nn = 1_000_000\ncheckpoints = np.unique(np.geomspace(10, n, 90).astype(int))\n\nfig, ax = plt.subplots(figsize=FIGURE_SIZES[\"single\"])\n\nfor alpha, seed, color in [\n    (0.8, 20260523, COLORS[\"brick\"]),\n    (1.3, 20260525, COLORS[\"green\"]),\n]:\n    rng = np.random.default_rng(seed)\n    sample = pareto_type1.rvs(alpha, size=n, random_state=rng)\n    means = running_mean(sample)\n\n    ax.loglog(\n        checkpoints,\n        means[checkpoints - 1],\n        color=color,\n        label=f\"alpha={alpha}\",\n    )\n\n    final_mean = float(means[-1])\n    max_share = float(max_to_sum_ratio(sample))\n    print(f\"Pareto alpha={alpha}:\")\n    print(f\"  final running mean after {n:,} draws: {final_mean:.3f}\")\n    print(f\"  largest observation's share of total: {max_share:.3f}\")\n\n    if alpha > 1:\n        print(f\"  finite theoretical mean: {alpha / (alpha - 1):.3f}\")\n        ax.axhline(\n            alpha / (alpha - 1),\n            color=color,\n            ls=\"--\",\n            alpha=0.8,\n        )\n    else:\n        print(\"  finite theoretical mean: none\")\n\nax.set_xlabel(\"sample size n\")\nax.set_ylabel(\"running mean\")\nax.set_title(\"Pre-asymptotic running means\")\nax.legend()\nstyle_axes(ax, grid_axis=\"both\")\nplt.show()","identifier":"lln-preasymptotic-python-check-code","enumerator":"1","html_id":"lln-preasymptotic-python-check-code","key":"XmCUNLS2nw"},{"type":"outputs","id":"27YiWjsJEuSz54-bkd7Vt","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Pareto alpha=0.8:\n  final running mean after 1,000,000 draws: 91.390\n  largest observation's share of total: 0.054\n  finite theoretical mean: none\nPareto alpha=1.3:\n  final running mean after 1,000,000 draws: 4.118\n  largest observation's share of total: 0.006\n  finite theoretical mean: 4.333\n"},"identifier":"lln-preasymptotic-python-check-outputs-0","html_id":"lln-preasymptotic-python-