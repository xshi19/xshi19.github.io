</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0037em;\">α</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:2em;\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10903em;\">U</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∼</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop\"><span class=\"mord mathrm\">Uniform</span></span><span class=\"mopen\">(</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mclose\">)</span><span class=\"mord\">.</span></span></span></span></span>","enumerator":"2","key":"myB9bkgeT7"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"The distribution helper in ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"NXfcO9lICd"},{"type":"inlineCode","value":"incerto.distributions","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"aCMPyca9Sl"},{"type":"text","value":" implements the same Pareto\nType I law.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"AKQfDQzo1K"}],"key":"VKGO2YIjWM"},{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Running-mean paths","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"iEsbbTd1Tp"}],"identifier":"running-mean-paths","label":"Running-mean paths","html_id":"running-mean-paths","implicit":true,"key":"QwdyZyo8ma"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"The left panel shows single running-mean paths at log-spaced checkpoints.  The\nright panel summarizes repeated final sample means at several sample sizes.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"hpyzvlSwIR"}],"key":"jaiRgCSpMA"}],"key":"p7dtM2K0bM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\nfrom incerto.distributions import pareto_type1\nfrom incerto.estimators import max_to_sum_ratio, running_mean\nfrom incerto.figures import COLORS, FIGURE_SIZES, set_theme, style_axes\n\nset_theme()\n\npath_n = 300_000\ncheckpoints = np.unique(np.geomspace(10, path_n, 90).astype(int))\npath_specs = [\n    (0.8, 20260617, COLORS[\"brick\"]),\n    (1.0, 20260618, COLORS[\"umber\"]),\n    (1.3, 20260619, COLORS[\"green\"]),\n]\n\nn_values = np.array([300, 1_000, 3_000, 10_000, 30_000])\n\n\ndef final_mean_quantiles(alpha, n, reps=300, batch=50, seed=20260617):\n    rng = np.random.default_rng(seed)\n    means = np.empty(reps)\n    for start in range(0, reps, batch):\n        stop = min(start + batch, reps)\n        sample = pareto_type1.rvs(\n            alpha,\n            size=(stop - start, n),\n            random_state=rng,\n        )\n        means[start:stop] = sample.mean(axis=1)\n    return np.quantile(means, [0.10, 0.50, 0.90])\n\n\nfig, axes = plt.subplots(1, 2, figsize=FIGURE_SIZES[\"two_panel\"])\n\nfor alpha, seed, color in path_specs:\n    rng = np.random.default_rng(seed)\n    sample = pareto_type1.rvs(alpha, size=path_n, random_state=rng)\n    means = running_mean(sample)\n\n    axes[0].loglog(\n        checkpoints,\n        means[checkpoints - 1],\n        color=color,\n        label=fr\"$\\alpha={alpha}$\",\n    )\n\n    if alpha > 1:\n        axes[0].axhline(alpha / (alpha - 1), color=color, ls=\"--\", alpha=0.8)\n\n    print(f\"Pareto alpha={alpha}:\")\n    print(f\"  final running mean after {path_n:,} draws: {float(means[-1]):.3f}\")\n    print(f\"  largest observation's share of total: {float(max_to_sum_ratio(sample)):.3f}\")\n    if alpha > 1:\n        print(f\"  finite theoretical mean: {alpha / (alpha - 1):.3f}\")\n    else:\n        print(\"  finite theoretical mean: none\")\n\naxes[0].set_xlabel(\"sample size n\")\naxes[0].set_ylabel(\"running mean\")\naxes[0].set_title(\"Single running-mean paths\")\naxes[0].legend()\n\nfor alpha, color in [(0.8, COLORS[\"brick\"]), (1.3, COLORS[\"green\"])]:\n    qs = np.array(\n        [\n            final_mean_quantiles(alpha, n, seed=20260617 + int(100 * alpha) + n)\n            for n in n_values\n        ]\n    )\n    axes[1].fill_between(n_values, qs[:, 0], qs[:, 2], color=color, alpha=0.18)\n    axes[1].plot(n_values, qs[:, 1], color=color, marker=\"o\", label=fr\"$\\alpha={alpha}$ median\")\n\naxes[1].axhline(1.3 / (1.3 - 1), color=COLORS[\"green\"], ls=\"--\", alpha=0.8)\naxes[1].set_xscale(\"log\")\naxes[1].set_yscale(\"log\")\naxes[1].set_xlabel(\"sample size n\")\naxes[1].set_ylabel(\"sample-mean quantiles\")\naxes[1].set_title(\"Repeated-simulation bands\")\naxes[1].legend()\n\nstyle_axes(axes, grid_axis=\"both\")\nplt.show()","identifier":"lln-preasymptotic-running-means-code","visibility":"hide","enumerator":"1","html_id":"lln-preasymptotic-running-means-code","key":"sg1V6HOhPj"},{"type":"outputs","id":"PLo8ZP_tF5doiURhG0z28","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Pareto alpha=0.8:\n  final running mean after 300,000 draws: 454.983\n  largest observation's share of total: 0.600\n  finite theoretical mean: none\nPareto alpha=1.0:\n  final running mean after 300,000 draws: 12.020\n  largest observation's share of total: 0.070\n  finite theoretical mean: none\nPareto alpha=1.3:\n  final running mean after 300,000 draws: 4.100\n  largest observation's share of total: 0.010\n  finite theoretical mean: 4.333\n"},"identifier":"lln-preasymptotic-running-means-outputs-0","html_id":"lln-preasymptotic-running-means-outputs-0","key":"p93MJgX4Fh"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1152x547.2 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"53e827226cce29b317a297f4bed0e7e8","path":"/incerto-wiki/build/53e827226cce29b317a297f4bed0e7e8.png"}}},"identifier":"lln-preasymptotic-running-means-outputs-1","html_id":"lln-preasymptotic-running-means-outputs-1","key":"DeOmckZN7Y"}],"identifier":"lln-preasymptotic-running-means-outputs","visibility":"show","html_id":"lln-preasymptotic-running-means-outputs","key":"MoQcujeUOX"}],"data":{"tags":[]},"label":"lln-preasymptotic-running-means","identifier":"lln-preasymptotic-running-means","visibility":"show","html_id":"lln-preasymptotic-running-means","key":"MDqKqTORFl"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":150,"column":1},"end":{"line":152,"column":1}},"children":[{"type":"strong","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"What to notice.","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"key":"gmoh3jCY1G"}],"key":"b34MXtmj1l"},{"type":"text","value":" For ","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"key":"hyUjF7XkSm"},{"type":"inlineMath","value":"\\alpha\\le1","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>α</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding=\"application/x-tex\">\\alpha\\le1</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"he