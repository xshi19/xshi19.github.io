"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Python","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"CFPdSFsA36"}],"identifier":"python","label":"Python","html_id":"python","implicit":true,"key":"w0K4gJPoHL"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Run ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"W0I1DEJ7An"},{"type":"inlineCode","value":"python scripts/fetch_data.py sp500","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"mkiW5YAYvi"},{"type":"text","value":" to fetch the FRED path, or\n","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"urmVVIrIGC"},{"type":"inlineCode","value":"python scripts/fetch_data.py sp500 --source path/to/local.csv","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"ZcWizcBgJK"},{"type":"text","value":" if you already\nhave a licensed local CSV.  The code cell skips gracefully when the cache is\nnot present.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"ExGGnNH5ZT"}],"key":"ap55UKkB1H"}],"key":"qZuAe5oTnc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\n\nfrom incerto.datasets import DatasetNotAvailable, load_sp500_prices\nfrom incerto.estimators import hill_alpha_estimator, hill_stability, mean_excess\nfrom incerto.figures import COLORS, FIGURE_SIZES, set_theme, style_axes\n\nset_theme()\n\ntry:\n    prices = load_sp500_prices()\nexcept DatasetNotAvailable as exc:\n    print(exc)\nelse:\n    loss_dates, losses = prices.negative_log_returns()\n    print(\n        f\"{prices.name}: {prices.date[0]} to {prices.date[-1]}, \"\n        f\"{prices.close.size:,} closes, {losses.size:,} negative-return days\"\n    )\n\n    order = np.sort(losses)\n    survival = 1 - np.arange(1, order.size + 1) / (order.size + 1)\n\n    ks = np.unique(\n        np.geomspace(10, min(500, max(11, losses.size // 3)), 80).astype(int)\n    )\n    stability = hill_stability(losses, ks)\n\n    thresholds = np.quantile(losses, np.linspace(0.80, 0.99, 35))\n    me = mean_excess(losses, thresholds, min_exceedances=20)\n\n    fig, axes = plt.subplots(1, 3, figsize=FIGURE_SIZES[\"three_panel\"])\n\n    axes[0].loglog(order, survival, color=COLORS[\"accent\"])\n    axes[0].set_xlabel(\"daily log loss\")\n    axes[0].set_ylabel(\"empirical survival\")\n    axes[0].set_title(\"Loss survival\")\n\n    axes[1].semilogx(stability[\"k\"], stability[\"alpha\"], color=COLORS[\"umber\"])\n    axes[1].set_xlabel(\"upper order statistics k\")\n    axes[1].set_ylabel(\"Hill alpha\")\n    axes[1].set_title(\"Hill stability\")\n\n    axes[2].plot(me[\"threshold\"], me[\"mean_excess\"], color=COLORS[\"green\"])\n    axes[2].set_xlabel(\"threshold u\")\n    axes[2].set_ylabel(\"mean excess\")\n    axes[2].set_title(\"Mean excess\")\n\n    style_axes(axes, grid_axis=\"both\")\n    fig.tight_layout()\n    plt.show()\n\n    for k in [25, 50, 100, 200, 400]:\n        if k < losses.size:\n            print(f\"Hill alpha for k={k:3d}: {hill_alpha_estimator(losses, k):.2f}\")\n\n    largest = np.argsort(losses)[-5:][::-1]\n    print(\"Largest one-day log losses:\")\n    for i in largest:\n        print(f\"  {loss_dates[i]}: {losses[i]:.3f}\")","identifier":"sp500-tail-python-check-code","enumerator":"1","html_id":"sp500-tail-python-check-code","key":"oxa3naF3Ih"},{"type":"outputs","id":"i79XAFHD6dkyrEf-86Yi-","children":[],"identifier":"sp500-tail-python-check-outputs","html_id":"sp500-tail-python-check-outputs","key":"StOfj8omzc"}],"label":"sp500-tail-python-check","identifier":"sp500-tail-python-check","html_id":"sp500-tail-python-check","key":"cgKHPOrRVa"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":124,"column":1},