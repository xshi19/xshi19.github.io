","label":"Diagnostics","html_id":"diagnostics","implicit":true,"key":"GnqToy9DtT"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"There is no theorem proving that equity-index losses follow a\n","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"I0b4fWl1iD"},{"type":"link","url":"/pareto","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Pareto law","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"oNtkqjaDTq"}],"urlSource":"../distributions/pareto.md","dataUrl":"/pareto.json","internal":true,"protocol":"file","key":"FhUCSyCF4o"},{"type":"text","value":".  The computation has three\nreproducible steps:","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"TvO4S5fsiG"}],"key":"O8eyrKADJ8"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":59,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Clean daily closes into a date/close cache.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"jCwt3SSCYU"}],"key":"jvkar16EYc"}],"key":"xwUmd9IMLv"},{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Transform closes into positive log losses.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"pBJAVxrhj4"}],"key":"GGojBf6dt8"}],"key":"o5jHcYlbK8"},{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Apply ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"j1PKlP2lFH"},{"type":"link","url":"/tail-threshold-selection","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Tail Threshold Selection","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"Q9GYDJMgkM"}],"urlSource":"../methods/tail-threshold-selection.md","dataUrl":"/tail-threshold-selection.json","internal":true,"protocol":"file","key":"hdYNzK6hyd"},{"type":"text","value":",\nthe Hill estimator, and\n","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"vUlfonyiJq"},{"type":"link","url":"/mean-excess-function","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Mean Excess Function","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"PV5MdXhy0i"}],"urlSource":"../theorems/mean-excess-function.md","dataUrl":"/mean-excess-function.json","internal":true,"protocol":"file","key":"vdlpsUYGpb"},{"type":"text","value":" to the loss\nsample.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"eVIASL5aSN"}],"key":"NepTnNb7BC"}],"key":"oJ5NEbjk9a"}],"key":"bvB3T1SDJc"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Any claim made from this page is empirical and conditional on the sample\nwindow, the one-day horizon, and the threshold choices.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"hT048YrlVq"}],"key":"DKoYOEoijp"}],"key":"cZoYDzO7ov"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom IPython.display import Markdown, display\n\nfrom incerto.datasets import DatasetNotAvailable, load_sp500_prices\nfrom incerto.estimators import hill_alpha_estimator, hill_stability, mean_excess\nfrom incerto.figures import COLORS, FIGURE_SIZES, set_theme, style_axes\n\nset_theme()\n\ntry:\n    prices = load_sp500_prices(fetch=False)\nexcept DatasetNotAvailable:\n    display(\n        Markdown(\n            \"**Data unavailable in this build.** The S&P 500 cache is \"\n            \"deliberately untracked because FRED notes S&P Dow Jones \"\n            \"redistribution restrictions. To reproduce the diagnostics, run \"\n            \"`python scripts/fetch_data.py sp500` with network access and \"\n            \"rebuild the page locally.\"\n        )\n    )\nelse:\n    loss_dates, losses = prices.negative_log_returns()\n    print(\n        f\"{prices.name}: {prices.date[0]} to {prices.date[-1]}, \"\n        f\"{prices.close.size:,} closes, {losses.size:,} negative-return days\"\n    )\n\n    order = np.sort(losses)\n    survival = 1 - np.arange(1, order.size + 1) / (order.size + 1)\n\n    ks = np.unique(\n        np.geomspace(10, min(500, max(11, losses.size // 3)), 80).astype(int)\n    )\n    stability = hill_stability(losses, ks)\n\n    thresholds = np.quantile(losses, np.linspace(0.80, 0.99, 35))\n    me = mean_excess(losses, thresholds, min_exceedances=20)\n\n    fig, axes = plt.subplots(3, 1, figsize=(6.4, 10.8), constrained_layout=True)\n\n    axes[0].loglog(order, survival, color=COLORS[\"accent\"])\n    axes[0].set_xlabel(\"daily log loss\")\n    axes[0].set_ylabel(\"empirical survival\")\n    axes[0].set_title(\"Loss survival\")\n\n    axes[1].semilogx(stability[\"k\"], stability[\"alpha\"], color=COLORS[\"umber\"])\n    axes[1].set_xlabel(\"upper order statistics k\")\n    axes[1].set_ylabel(r\"Hill $\\widehat\\alpha$\")\n    axes[1].set_title(\"Hill stability\")\n\n    axes[2].plot(me[\"threshold\"], me[\"mean_excess\"], color=COLORS[\"green\"])\n    axes[2].set_xlabel(\"threshold u\")\n    axes[2].set_ylabel(\"mean excess\")\n    axes[2].set_title(\"Mean excess\")\n\n    style_axes(axes, grid_axis=\"both\")\n    plt.show()\n\n    for k in [25, 50, 100, 200, 400]:\n        if k < losses.size:\n            print(f\"Hill alpha for k={k:3d}: {hill_alpha_estimator(losses, k):.2f}\")\n\n    largest = np.argsort(losses)[-5:][::-1]\n    print(\"Largest one-day log losses:\")\n    for i in largest:\n        print(f\"  {loss_dates[i]}: {losses[i]:.3f}\")","identifier":"sp500-tail-diagnostics-code","visibility":"hide","enumerator":"1","html_id":"sp500-tail-diagnostics-code","key":"URYGdnmYYO"},{"type":"outputs","id":"IxXO66E9cPR4v6G3F92bO","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.Markdown object>","content_type":"text/plain"},"text/markdown":{"content":"**Data unavailable in this build.** The S&P 500 cache is deliberately untracked because FRED notes S&P Dow Jones redistribution restrictions. To reproduce the diagnostics, run `python scripts/fetch_data.py sp500` with network access and rebuild the page locally.","content_type":"text/markdown"}}},"identifier":"sp500-tail-diagnostics-outputs-0","html_id":"sp500-tail-diagnostics-outputs-0","key":"fMCFG0DPWX"}],"identifier":"sp500-tail-diagnostics-outputs","visibility":"show","html_id":"sp500-tail-diagnostics-outputs","key":"dGXZkbhYAm"}],"data":{"tags":[]},"label":"sp500-tail-diagnostics","identifier":"sp500-tail-diagnostics","visibility":"show","html_id":"sp500-tail-diagnostics","key":"mpb4tlD7EO"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":143,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"The survival, Hill, and mean-excess panels give related but\nnot identical views of the right tail.  The Hill estimates should be read as a\nsensitivity range, not a single fitted truth.  The largest observations usually\nidentify crisis days, which is exactly why iid threshold models need caveats\nfor dependence and volatility clustering.","position":{"start":{"line":143,"column":1},"end":{"line":143,"column"